# Application
APP_NAME=UGen AI Gateway
APP_ENV=development

# Master key; required when APP_ENV=production. Sent as X-API-Key or a bearer token.
# Per-team keys are created through the admin API (see README).
GATEWAY_API_KEY=
# Per client IP, within the rolling window below.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Models are set up on the dashboard's Models page. The LOCAL_* and CLOUD_*
# values below only fill that page until it is first saved.
# Local OpenAI-compatible model endpoint (example: Ollama)
LOCAL_API_KEY=local
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b
# Optional public name shown in the dashboard and API instead of LOCAL_MODEL.
LOCAL_MODEL_ALIAS=

# Optional: several providers, models and routing rules (see routing.example.yaml).
# When set, LOCAL_* and CLOUD_* are ignored.
ROUTING_CONFIG=

# Optional cloud provider. Leave both values blank to disable cloud routing.
# When enabled, use a model name supported by your provider.
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_MODEL=
CLOUD_MODEL_ALIAS=

# Request analysis: hybrid (default), llm, or rules. See README.
ANALYSIS_MODE=hybrid
# Lowest difficulty sent to the cloud in Auto mode: moderate (default) or complex.
CLOUD_FROM=moderate
ANALYSIS_CACHE_SIZE=256
ANALYSIS_CACHE_TTL_SECONDS=600

# Name and place detection. On in the Docker image (Chinese and English);
# set PII_NER=none to turn it off. Outside Docker it needs uv sync --extra ner
# and the spaCy models (see README).
# PII_NER=presidio
# PII_NER_LANGUAGE=zh,en
# PII_NER_SPACY_MODEL=zh_core_web_sm,en_core_web_sm

# Guards. INJECTION_ACTION: off, flag, local, block. OUTPUT_PII_ACTION: off, flag, redact.
INJECTION_ACTION=flag
OUTPUT_PII_ACTION=off
# Manages API keys and reads the audit log. Setting it also requires a key for chat.
ADMIN_API_KEY=

# SQLite database: accounts, API keys, request metadata and feedback (never
# message text). Empty disables accounts and usage tracking.
USAGE_DB_PATH=data/ugen.db

# Encrypts provider API keys and the single sign-on secret stored in the
# database. When blank, a secret.key file is created next to the database;
# back it up together with the database.
SECRET_KEY=

# Dashboard accounts. The first account becomes the administrator; set
# ALLOW_REGISTRATION=false to stop further sign-ups after that.
ALLOW_REGISTRATION=true
SESSION_TTL_DAYS=30
# Saved conversations per account in MB (compressed and encrypted).
CONVERSATION_STORAGE_MB=200

# Docker only: where the gateway (API and dashboard) listens. Set
# GATEWAY_HOST=127.0.0.1 when an HTTPS reverse proxy on this machine fronts it.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=7632
# Docker only: run the published image instead of building it here, then
# update with: docker compose pull && docker compose up -d
# UGEN_IMAGE=ghcr.io/baihufox3210/ugen-ai-gateway:latest

# Provider client settings
REQUEST_TIMEOUT=300
MAX_RETRIES=2

# Fallback when the routed provider is down. See README.
FALLBACK_TO_LOCAL=true
FALLBACK_TO_CLOUD=false
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
